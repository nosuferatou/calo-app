NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable only after the Google provider and redirect URLs exist in Supabase.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
# The auth site URL and redirect allow-list are configured in the Supabase Auth
# dashboard; the app derives callback URLs from the request origin, so there is
# no site-URL variable to set here.
